# ==================================================
# Application
# ==================================================
APP_NAME=LEVL-BACKEND
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Omitted or uat = realistic ledger, timeline, personas (default). full = legacy random GamificationDataSeeder.
# SEEDING_MODE=full


# ==================================================
# Logging
# ==================================================
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null


# ==================================================
# Database
# ==================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=levl
DB_USERNAME=postgres
DB_PASSWORD=change-me


# ==================================================
# Session
# ==================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# ==================================================
# Cache, Queue, Broadcast
# ==================================================
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

MEMCACHED_HOST=127.0.0.1


# ==================================================
# Redis
# ==================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# ==================================================
# Mail
# ==================================================
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ta-prep-lsp.local"
MAIL_FROM_NAME="${APP_NAME}"


# ==================================================
# Local VPS filesystem
# ==================================================
FILESYSTEM_DISK=public
MEDIA_DISK=public

IMAGE_QUALITY=85
UPLOAD_MAX_FILE_SIZE_KB=2048
UPLOAD_MAX_VIDEO_SIZE_KB=51200


# ==================================================
# Authentication
# ==================================================
# JWT
JWT_SECRET=

# Initial production account (required only for ProductionSeeder)
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=Superadmin
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/v1/auth/google/callback
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=


# ==================================================
# Frontend & CORS
# ==================================================
FRONTEND_URL=https://frontend.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://frontend.example.com,https://api.example.com


# ==================================================
# Telescope
# ==================================================
TELESCOPE_ENABLED=false


# ==================================================
# Query Detector (N+1 Detection)
# ==================================================
# Only enable in local environment for development
QUERY_DETECTOR_ENABLED=false
QUERY_DETECTOR_THRESHOLD=1
QUERY_DETECTOR_LOG_CHANNEL=daily


# ==================================================
# Clockwork (Performance Profiling - Local Only)
# ==================================================
CLOCKWORK_ENABLE=false
CLOCKWORK_WEB=false
CLOCKWORK_TOOLBAR=false
CLOCKWORK_DATABASE_SLOW_THRESHOLD=50
CLOCKWORK_DATABASE_DETECT_DUPLICATE_QUERIES=true
CLOCKWORK_HTTP_REQUESTS_ENABLED=true
CLOCKWORK_REQUESTS_SLOW_THRESHOLD=200


# ==================================================
# Scout / Meilisearch
# ==================================================
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=


# ==================================================
# Laravel Octane
# ==================================================
OCTANE_SERVER=frankenphp
OCTANE_WORKERS=2
OCTANE_MAX_REQUESTS=1000


# ==================================================
# Vite
# ==================================================
VITE_APP_NAME="${APP_NAME}"
